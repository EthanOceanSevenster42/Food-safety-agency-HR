# Dependencies
node_modules/

# Environment files (NEVER COMMIT — contain DB password, JWT secret, Graph client secret)
.env
.env.*
!.env.example

# Build artefacts
frontend/dist/
backend/dist/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / app uploads (regenerated per environment — logos, asset photos, repair PDFs)
backend/uploads/*
!backend/uploads/.gitkeep

# Test scratch files
backend/scripts/test-*.output

# Temp files generated by SQL Server scripts
*.bak
*.trc

# Claude Code session memory — local-only context, not part of the project
memory/

# LANCorp production seed data — real employee names, work email addresses and
# bcrypt password hashes from four companies. The FSA system never loads it
# (it seeds from db/fsa-hr-content.js instead). Kept on disk, never published.
backend/db/seed-data.sql
backend/db/seed-data-mysql.sql

# Claude Code local settings — holds machine-local allow-list entries that can
# embed hostnames and credentials. Local-only, like memory/.
.claude/

# Browser-automation artefacts from verification runs
.playwright-mcp/
*-after.png
