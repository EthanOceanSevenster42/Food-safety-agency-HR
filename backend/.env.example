# ----------------------------------------------------------------------------
# LANCorp backend environment variables.
# Copy this file to backend/.env and fill in the blanks.
# Never commit .env to source control.
# ----------------------------------------------------------------------------

# HTTP
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ----------------------------------------------------------------------------
# Microsoft SQL Server connection
#   - DB_SERVER:   the hostname or IP of the SQL Server, optionally with an
#                  instance name. Examples: "localhost", "localhost\\SQLEXPRESS",
#                  "10.0.0.5", "db.internal".
#   - DB_DATABASE: the database name (created automatically by db/schema.sql).
#   - DB_USER / DB_PASSWORD: SQL login credentials. The login must have at
#                  least dbcreator rights for the first run, then db_owner on
#                  the lancorp database afterwards.
#   - DB_ENCRYPT: set to "true" if your SQL Server is configured for TLS.
#   - DB_TRUST_SERVER_CERTIFICATE: set to "true" for local dev / self-signed
#                  certificates. Leave "false" in production.
# ----------------------------------------------------------------------------
DB_SERVER=localhost
DB_DATABASE=lancorp
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# ----------------------------------------------------------------------------
# Auth — JWT_SECRET should be a long random string (>= 48 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ----------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ----------------------------------------------------------------------------
# Email — Microsoft Graph (preferred). Fill all four to enable.
# Requires an Entra ID app registration with the Mail.Send Application
# permission and admin consent. See README.md -> Email setup.
# ----------------------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Mailbox that performs the send (owns the Sent Items copy).
GRAPH_SEND_AS=
# Optional: visible From address (e.g. a shared inbox). Defaults to GRAPH_SEND_AS.
# GRAPH_SEND_AS must have "Send As" rights on this mailbox in Exchange.
GRAPH_FROM=

# ----------------------------------------------------------------------------
# Email — SMTP fallback (only used when Graph is not configured).
# When neither is set the backend logs emails to the console as a stub.
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public-facing base URL (used in email links)
APP_BASE_URL=http://localhost:5173
